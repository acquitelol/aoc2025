use std/prelude;

fn solve(string[] grid) {
    i64 sc = grid[0].iter().position(fn: it == 'S').unwrap();
    i64 splits = 0;
    ways := $map(#[$(sc, #cast(i64, 1))]);

    for r in 1..grid.len() {
        next := HashMap::new<i64, i64>();

        for c, count in ways {
            if 0 > c || c >= grid[0].len() { continue; }
            cell := grid[r][c];

            if cell == '^' { splits += 1; }
            for nc in cell == '^' ? [c - 1, c + 1] : [c] {
                if 0 <= nc && nc < grid[0].len() {
                    next[nc] = next.get(nc).unwrap_or(0) + count;
                }
            }
        }

        ways = next;
    }

    return #[splits, ways.values().sum()];
}

fn main(string[] args) {
    grid := io::read_to_string(args[1]).split("\n");
    $dbg(solve(grid));
}