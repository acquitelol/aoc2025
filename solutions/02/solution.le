use std/prelude;

fn is_twice(i64 x) {
    d := 1 + #cast(i64, math::floorf(math::log10f(x)));
    if d % 2 != 0 { return false; }

    p := (0..d / 2).fold(1, fn: it * 10);
    return x / p == x % p;
}

fn is_repeat(i64 x) {
    d := 1 + #cast(i64, math::floorf(math::log10f(x)));
    k := 1;

    while k * 2 <= d {
        if d % k == 0 {
            p := 1;
            for i := 0; i < k; i += 1 { p *= 10; }

            base := x % p;
            y := x;
            good := true;

            for count := d / k; count > 0; count -= 1 {
                if y % p != base {
                    good = false;
                    break;
                }
                y /= p;
            }

            if good { return true; }
        }

        k += 1;
    }

    return false;
}

fn solve(string[] parts, bool p2) {
    total: i64 = 0;

    for start, end in parts.map(fn: it.nums_by<i64>([])) {
        while start <= end {
            if p2 ? is_repeat(start) : is_twice(start) {
                total += start;
            }

            start += 1;
        }
    }

    return total;
}

fn main(string[] args) {
    parts := io::read_to_string(args[1]).split(",");
    $dbg(solve(parts, false));
    $dbg(solve(parts, true));
}