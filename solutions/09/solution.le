use std/prelude;

fn contained((i64[2], i64[2])[] edges, (i64, i64) mx, (i64, i64) my) {
    for i := 0; i < edges.len(); i += 1 {
        e := edges[i];
        if mx.x < e.y[0] && mx.y > e.x[0] && my.x < e.y[1] && my.y > e.x[1] {
            return false;
        }
    }

    return true;
}

fn solve(string[] lines) {
    tiles := lines.map(fn(l) l.split(",").map(i64::parse));
    edges := [](i64[2], i64[2]);
    i64[2] best = #[0, 0];

    for i := 0; i < tiles.len(); i += 1 {
        p := #[tiles[i], tiles[(i + 1) % tiles.len()]];

        edges.push($(
            #[math::min(p[0][0], p[1][0]), math::min(p[0][1], p[1][1])],
            #[math::max(p[0][0], p[1][0]), math::max(p[0][1], p[1][1])]
        ));
    }

    for i := 0; i < tiles.len(); i += 1 {
        for j := i; j < tiles.len(); j += 1 {
            if i >= j { continue; }
            p1, p2 := $(tiles[i], tiles[j]);
            area := (math::abs(p1[0] - p2[0]) + 1) * (math::abs(p1[1] - p2[1]) + 1);
            if area > best[0] { best[0] = area; }
            if area <= best[1] { continue; }

            mx := p1[0] < p2[0] ? $(p1[0], p2[0]) : $(p2[0], p1[0]);
            my := p1[1] < p2[1] ? $(p1[1], p2[1]) : $(p2[1], p1[1]);
            if contained(edges, mx, my) { best[1] = area; }
        }
    }

    return best;
}

fn main(string[] args) {
    lines := io::read_to_string(args[1]).strip().split("\n");
    $dbg(solve(lines));
}