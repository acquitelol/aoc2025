use std/prelude;

fn find(i64[] parent, i64 x) -> i64 {
    while x != parent[x] {
        parent[x] = parent[parent[x]];
        x = parent[x];
    }
    return x;
}

fn unite(i64[] parent, i64 a, i64 b) -> bool {
    pa, pb := $(find(parent, a), find(parent, b));
    if pa == pb { return false; }
    parent[pb] = pa;
    return true;
}

fn solve(string[] lines) {
    boxes := lines.map(fn(l) l.split(",").map(i64::parse));
    circuits := (#cast(i64, 0)..boxes.len()).collect();
    i64[2] total = #[0, 0];

    dists := MinHeap::new<(f32, u64, u64)>(fn(a, b) #cast(i64, a.x - b.x));
    bdist := f32::inf;

    for i, box1 in boxes.iter().enumerate() {
        for j, box2 in boxes.iter().enumerate() {
            if i >= j { continue; }
            dist := box1.to_vec3().sub(box2.to_vec3()).length_sq();
            if dist < bdist { bdist = dist; }
            else if dist > bdist * 400 { continue; }
            dists.push($$(dist, i, j));
        }
    }

    step := 0;
    while _, d := dists.pop() {
        dist, d1, d2 := d;

        if step == 999 {
            counts := HashMap::new<i64, i64>();
            for c in 0..boxes.len() {
                root := find(circuits, c);
                counts[root] = counts.get(root).unwrap_or(0) + 1;
            }

            largest := counts.iter().collect().sort_with(fn(a, b) b.y - a.y).slice(0, 3);
            total[0] = largest.iter().map(fn(c) c.y).product();
        }

        if unite(circuits, d1, d2) {
            root0 := find(circuits, 0);
            all_one := true;

            for c in 1..boxes.len() {
                if find(circuits, c) != root0 {
                    all_one = false;
                    break;
                }
            }

            if all_one {
                total[1] = boxes[d1][0] * boxes[d2][0];
                break;
            }
        }

        step += 1;
    }

    return total;
}

fn main(string[] args) {
    lines := io::read_to_string(args[1]).split("\n");
    $dbg(solve(lines));
}