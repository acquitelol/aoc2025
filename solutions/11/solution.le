use std/prelude;

let cache = HashMap::new<(string, string), i64>();
let graph = HashMap::new<string, HashSet<string> *>();

fn dp(string start, string end) -> i64 {
    if start == end { return 0; }
    if graph.get_or_insert(start, HashSet::new<string>()).contains(end) { return 1; }
    if _, res := cache.get($(start, end)) { return res; }

    res := graph[start].iter().map_with(fn(x, end) dp(x, end), end).sum();
    cache[$(start, end)] = res;
    return res;
}

fn solve(string[] lines) {
    for line in lines {
        name, rest := line.split(": ").map(string::strip);
        graph.get_or_insert(name, HashSet::new<string>());
        for d in rest.split(" ") {
            graph[name].add(d);
        }
    }

    i64[2] total = #[0, 0];
    total[0] = dp("you", "out");

    for dac, fft in ["dac", "fft"].permutations() {
        a := dp("svr", dac);
        b := dp(dac, fft);
        c := dp(fft, "out");
        total[1] += a * b * c;
    }

    return total;
}

fn main(string[] args) {
    lines := io::read_to_string(args[1]).strip().split("\n");
    $dbg(solve(lines));
}