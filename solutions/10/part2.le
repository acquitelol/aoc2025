use std/prelude;
global pub;

let eps = 1.0e-3;
let tab = []f32[];
let base: i32[];
let head: i32[];
let rows: u64;
let cols: u64;

fn pivot(i32 r, i32 s) {
    inv := 1.0 / tab[r][s];

    for i := 0; i < rows + 2; i += 1 {
        if i == r { continue; }

        for j := 0; j < cols + 2; j += 1 {
            if j != s {
                tab[i][j] -= tab[r][j] * tab[i][s] * inv;
            }
        }
    }

    for j := 0; j < cols + 2; j += 1 {
        tab[r][j] *= inv;
    }

    for i := 0; i < rows + 2; i += 1 {
        if i != r { tab[i][s] *= -inv; }
    }

    tmp := head[s];
    tab[r][s] = inv;
    head[s] = base[r];
    base[r] = tmp;
}

fn walk(i32 phase) {
    for ;; {
        s := -1;
        min_value := f32::inf;
        min_tiebreak := i32::MAX;

        for i := 0; i < cols + 1; i += 1 {
            if !(phase || head[i] != -1) { continue; }
            value := tab[rows + phase][i];
            tiebreak := head[i];

            if s == -1
                || value + eps < min_value
                || math::abs(value - min_value) <= eps && tiebreak < min_tiebreak
            {
                s = i;
                min_value = value;
                min_tiebreak = tiebreak;
            }
        }

        if s == -1 || tab[rows + phase][s] > -eps { return 1; }

        r := -1;
        min_ratio := f32::inf;
        min_tiebreak := i32::MAX;

        for i := 0; i < rows; i += 1 {
            if tab[i][s] <= eps { continue; }

            ratio := tab[i][-1] / tab[i][s];
            tiebreak := base[i];

            if r == -1 || ratio + eps < min_ratio
                || math::abs(ratio - min_ratio) <= eps && tiebreak < min_tiebreak
            {
                r = i;
                min_ratio = ratio;
                min_tiebreak = tiebreak;
            }
        }

        if r == -1 { return 0; }
        pivot(r, s);
    }
}

fn simplex(f32[][] tableau, f32[] target) -> Option<(f32, f32[])> {
    rows, cols = $(tableau.len(), tableau[0].len() - 1);

    head = (0..cols).collect();
    head.push(-1);
    base = (#cast(i32, cols)..cols + rows).collect();
    tab.clear();

    for row in tableau {
        new_row := row.clone();
        new_row.push(-1.0);
        tab.push(new_row);
    }

    cost_row := target.clone();
    cost_row.extend([0, 0]f32);
    tab.push(cost_row);

    zero_row := Array::with_capacity<f32>(cols + 2).fill(0.0);
    tab.push(zero_row);

    for i := 0; i < rows; i += 1 {
        tmp := tab[i][-1];
        tab[i][-1] = tab[i][-2];
        tab[i][-2] = tmp;
    }

    tab[-1][cols] = 1.0;

    r := -1;
    min_value := f32::inf;
    for i := 0; i < rows; i += 1 {
        value := tab[i][-1];
        if r == -1 || value + eps < min_value {
            r = i;
            min_value = value;
        }
    }

    if tab[r][-1] < -eps {
        pivot(r, cols);
        if !walk(1) || tab[-1][-1] < -eps {
            return None();
        }
    }

    for i := 0; i < rows; i += 1 {
        if base[i] == -1 {
            s := -1;
            min_value := i32::max();
            min_tiebreak := i32::max();

            for j := 0; j < cols + 1; j += 1 {
                value := tab[i][j];
                tiebreak := head[j];

                if s == -1 || (value < min_value && tiebreak < min_tiebreak) {
                    s = j;
                    min_value = value;
                    min_tiebreak = tiebreak;
                }
            }

            pivot(i, s);
        }
    }

    if walk(0) {
        solution := Array::with_capacity<f32>(cols).fill(0.0);
        best := 0.0;

        for i := 0; i < rows; i += 1 {
            if 0 <= base[i] && base[i] < cols {
                solution[base[i]] = tab[i][-1];
            }
        }

        for i := 0; i < cols; i += 1 {
            best += target[i] * solution[i];
        }

        return Some($(best, solution));
    }

    return None();
}

fn branch(f32[][] tableau, f32 *best, u64 n) {
    is_some, res := simplex(tableau, (0..n).map(fn() 1.0).collect());
    if !is_some { return; }

    val, solution := res;
    if val + eps >= *best { return; }

    for i, x in solution.iter().enumerate() {
        if math::abs(x - math::round(x)) > eps {
            v := #cast(i32, x);

            leq := (0..n).map(fn() 0.0).collect();
            leq.push(#cast(f32, v));
            leq[i] = 1.0;
            branch([tableau, [leq]].concat(), best, n);

            geq := (0..n).map(fn() 0.0).collect();
            geq.push(-(v + 1.0));
            geq[i] = -1.0;
            branch([tableau, [geq]].concat(), best, n);
            return;
        }
    }

    *best = val;
}