use std/prelude;

fn solve(string[] grid) {
    r, c := $(grid.len(), grid[0].len());
    dq := Deque::new<(i32, i32)>();
    n := #alloca(u8, r * c);
    parts := #[0, 0];

    for y, x in (0..r).cartesian_product(0..c) {
        if grid[y][x] != '@' { continue; }
        a := 0;

        for dy, dx in (-1..=1).cartesian_product(-1..=1) {
            if dx == 0 && dy == 0 { continue; }
            ny, nx := $(y + dy, x + dx);

            if 0 <= ny && ny < r && 0 <= nx && nx < c 
                && grid[ny][nx] == '@' 
            {
                a += 1;
            }
        }

        n[y * c + x] = a;

        if a < 4 {
            dq.push_back($(y, x));
            parts[0] += 1;
        }
    }

    while !dq.is_empty() {
        y, x := dq.pop_front().unwrap();
        if grid[y][x] != '@' || n[y * c + x] >= 4 { continue; }

        grid[y][x] = '.';
        parts[1] += 1;

        for dy, dx in (-1..=1).cartesian_product(-1..=1) {
            if dx == 0 && dy == 0 { continue; }
            ny, nx := $(y + dy, x + dx);

            if 0 <= ny && ny < r && 0 <= nx && nx < c 
                && grid[ny][nx] == '@' 
            {
                n[ny * c + nx] -= 1;
                if n[ny * c + nx] == 3 { dq.push_back($(ny, nx)); }
            }
        }
    }

    return parts;
}

fn main(string[] args) {
    grid := io::read_to_string(args[1]).split("\n");
    $dbg(solve(grid));
}